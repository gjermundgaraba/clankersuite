{
  "name": "clankersuite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run pixel-paper-catalog#dev",
    "prepare": "vp config && effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@clanker-stuff/oxlint-config": "catalog:",
    "@effect/tsgo": "catalog:",
    "@foldkit/oxlint-plugin": "catalog:",
    "ultracite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.0"
  }
}
