{
  "$schema": "https://designtokens.org/schemas/2025.10/resolver.json",
  "name": "clankersuite",
  "version": "2025.10",
  "description": "The clankersuite tokens: the palette, the semantic tokens, then the colours of the colour scheme.",
  "sets": {
    "primitive": {
      "description": "The colour palette the semantic colours alias.",
      "sources": [{ "$ref": "./primitive/color.tokens.json" }]
    },
    "semantic": {
      "description": "Semantic tokens that do not depend on the colour scheme.",
      "sources": [
        { "$ref": "./semantic/dimension.tokens.json" },
        { "$ref": "./semantic/duration.tokens.json" },
        { "$ref": "./semantic/number.tokens.json" },
        { "$ref": "./semantic/fontWeight.tokens.json" },
        { "$ref": "./semantic/fontFamily.tokens.json" },
        { "$ref": "./semantic/shadow.tokens.json" },
        { "$ref": "./semantic/cubicBezier.tokens.json" }
      ]
    }
  },
  "modifiers": {
    "colorScheme": {
      "description": "Selects semantic colours for the colour scheme.",
      "contexts": {
        "light": [{ "$ref": "./semantic/color/light.tokens.json" }],
        "dark": [{ "$ref": "./semantic/color/dark.tokens.json" }]
      },
      "default": "light"
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/primitive" },
    { "$ref": "#/sets/semantic" },
    { "$ref": "#/modifiers/colorScheme" }
  ]
}
