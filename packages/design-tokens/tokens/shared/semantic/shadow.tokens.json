{
  "$schema": "https://designtokens.org/schemas/2025.10/format.json",
  "$description": "Soft shadows on what floats over the page; controls sit flat.",
  "semantic": {
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "{semantic.color.shadow.default}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 12,
            "unit": "px"
          },
          "blur": {
            "value": 32,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "Anything that floats over the page."
      }
    }
  }
}
