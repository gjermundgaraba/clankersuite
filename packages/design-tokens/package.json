{
  "name": "@gjermundgaraba/design-tokens",
  "version": "0.8.0",
  "description": "Design tokens for the gjermundgaraba design system: W3C DTCG sources built by Terrazzo into one stylesheet per brand.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clankersuite.git",
    "directory": "packages/design-tokens"
  },
  "files": [
    "generated"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./clankersuite.css": "./generated/clankersuite.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tz build -c terrazzo.clankersuite.config.ts",
    "check": "tz check tokens/clankersuite.resolver.json"
  },
  "devDependencies": {
    "@terrazzo/cli": "catalog:",
    "@terrazzo/parser": "catalog:",
    "@terrazzo/plugin-css": "catalog:",
    "@types/node": "catalog:"
  }
}
